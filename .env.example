OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3
EMBED_DIM=1024
PORT=3000
DB_PATH=data/app.db
# Original PDF files of materials, named by material id (default: a files folder next to DB_PATH)
FILES_DIR=data/files

LOCAL_LLM_MODEL=gemma3:4b
LOCAL_MAX_CHARS=60000
LOCAL_PART_CHARS=15000
DEFAULT_PROVIDER=auto
ALLOW_EXTERNAL=true
OPENAI_MODELS=gpt-5-mini

OPENAI_MAX_OUTPUT_TOKENS=16000
OPENAI_REASONING_EFFORT=low

LOCAL_CONTEXT_TOKENS=16384
LOCAL_MAX_OUTPUT_TOKENS=2048

# Time limits of one call in milliseconds. Node.js waits at most 300 s for response headers,
# so OPENAI_TIMEOUT_MS above 300000 has no effect; local replies are streamed, so their limit
# covers the whole reply (the first part must still arrive within 300 s).
EMBED_TIMEOUT_MS=60000
OPENAI_TIMEOUT_MS=300000
LOCAL_CHAT_TIMEOUT_MS=900000